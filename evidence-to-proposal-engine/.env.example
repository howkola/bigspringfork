# Copy to .env and fill in. Never commit the real key — it lives server-side only.
# For local dev, `netlify dev` loads this automatically.

# Required: Anthropic API key (used only inside Netlify Functions).
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides (sensible defaults are baked in).
# Synthesis model for the cited section drafts:
SYNTHESIS_MODEL=claude-opus-4-8
# Cheap model for structuring raw Consensus output into citation entries:
STRUCTURING_MODEL=claude-haiku-4-5
# Model that drives the Consensus MCP retrieval searches:
RETRIEVAL_MODEL=claude-opus-4-8

# Optional: Consensus MCP endpoint (defaults to the public server).
CONSENSUS_MCP_URL=https://mcp.consensus.app/mcp

# Persistence (Phase 3) — save & revisit packets via a shareable slug.
# Both are server-side only. If unset, the app runs fine but Save is disabled.
# Use the SERVICE ROLE key (not the anon key): access is gated by the function,
# not by row-level security, and the key must never reach the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
